# Environment files
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Node / React Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
# The generic `lib/` rule above would swallow the frontend's source lib dir;
# keep frontend/src/lib/ tracked while ignoring stray Python `lib/` folders.
!frontend/src/lib/
!frontend/src/lib/**
.npm
.eslintcache

# Docker & OS
.DS_Store
Thumbs.db
*.log

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Data & Indexes (keep directory structure via .gitkeep)
data/*
!data/.gitkeep
indexes/*
!indexes/.gitkeep

# Local ML model cache (sentence-transformers / HuggingFace hub downloads)
.huggingface/
.hf_cache/
backend/.cache/
