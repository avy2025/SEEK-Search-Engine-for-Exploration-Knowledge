# SEEK Search Engine - Environment Configuration Strategy
# Copy this file to .env for local development

# ==========================================
# Application Settings
# ==========================================
APP_NAME="SEEK Search Engine"
APP_ENV="development" # development | production | testing
LOG_LEVEL="INFO" # DEBUG | INFO | WARNING | ERROR
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
FRONTEND_PORT=3000
VITE_API_BASE_URL="http://localhost:8000"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ==========================================
# Persistence (PostgreSQL) Settings
# ==========================================
POSTGRES_USER=seek_user
POSTGRES_PASSWORD=seek_dev_password
POSTGRES_DB=seek_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"

# ==========================================
# Crawler Strategy & Constraints (Phase 4+)
# ==========================================
CRAWLER_ALLOWED_DOMAINS="wikipedia.org,python.org,fastapi.tiangolo.com,react.dev"
CRAWLER_MAX_DEPTH=2
CRAWLER_CONCURRENT_REQUESTS=5
CRAWLER_TIMEOUT_SECONDS=10
CRAWLER_USER_AGENT="SEEK-Crawler/1.0 (+http://localhost:3000/bot-info)"
CRAWLER_RESPECT_ROBOTS=true

# ==========================================
# Keyword Retrieval & Vector Storage (Phase 5+)
# ==========================================
STORAGE_DATA_PATH="./data"
STORAGE_INDEX_PATH="./indexes"
BM25_K1=1.5
BM25_B=0.75
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
VECTOR_STORE_TYPE="faiss" # faiss | chromadb

# ==========================================
# Ranking Engine Weights (Phase 7+)
# ==========================================
WEIGHT_BM25=0.5
WEIGHT_SEMANTIC=0.3
WEIGHT_FRESHNESS=0.1
WEIGHT_AUTHORITY=0.1

# ==========================================
# Optional AI / RAG Configuration (Phase 8+)
# ==========================================
RAG_ENABLED=false
LLM_PROVIDER="local" # local | mock | optional_free_api
LLM_MODEL="none"
# LLM_API_KEY="" # Optional external key if using cloud free tier

# ==========================================
# Specialized Search Modes (Phase 9+)
# Mode = web | ai | research | code. Legacy modes bm25 | semantic | hybrid
# remain available and unchanged; the modes below reuse the same retrieval
# services and only adjust limits, ranking weights and post-processing.
# ==========================================
MODE_DEFAULT="web"      # mode used when no ?mode= is supplied
MODE_MAX_LIMIT=50       # hard per-request result cap for every mode
MODE_MAX_CANDIDATES=100 # upper bound for widened candidate retrieval

# Per-mode default result limits (a client-supplied ?limit= still wins)
MODE_WEB_LIMIT=10
MODE_AI_LIMIT=5
MODE_RESEARCH_LIMIT=15
MODE_CODE_LIMIT=10

# Optional AI synthesis per mode (research synthesises when enabled too)
MODE_AI_ENABLED=true
MODE_RESEARCH_RAG_ENABLED=true

# Research mode: wider retrieval + source/document diversification
RESEARCH_CANDIDATE_MULTIPLIER=4
RESEARCH_SOURCE_DIVERSITY_CAP=3
RESEARCH_SNIPPET_WORDS=56

# Code Docs mode: lexical-leaning ranking, documentation-source priority,
# technical term expansion and code-snippet extraction
CODE_CANDIDATE_MULTIPLIER=3
CODE_BM25_WEIGHT=0.7
CODE_SEMANTIC_WEIGHT=0.3
CODE_DOC_SOURCE_PRIORITY=true
CODE_TECHNICAL_TERM_EXPANSION=true
CODE_SNIPPET_WORDS=34
CODE_SNIPPET_MAX_CHARS=600

# A hit counts as a match only when its score exceeds this floor. The BM25
# engine always returns up to `limit` documents (unmatched ones score 0.0), so
# the specialized modes drop those padding rows instead of reporting them.
MODE_MATCH_SCORE_FLOOR=0.0
